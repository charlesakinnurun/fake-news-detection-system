# ---------------------------------------------------------------------------
# Fake News Detection - example environment configuration
#
# Copy to `.env` (which is git-ignored) and adjust. Every value below has a
# safe default inside `fake_news_detection.config.ServiceSettings`, so a local
# `.env` is optional for development.
#
# NEVER commit a real `.env` file or real credentials.
# ---------------------------------------------------------------------------

# --- API server -------------------------------------------------------------
FND_API_HOST=127.0.0.1
FND_API_PORT=8000
FND_API_WORKERS=1
FND_LOG_LEVEL=INFO

# Directory that holds `model.joblib` and `model_metadata.json`.
FND_ARTIFACT_DIR=artifacts
FND_MODEL_ARTIFACT=model.joblib
FND_MODEL_METADATA=model_metadata.json

# --- Inference safeguards ---------------------------------------------------
# Decision threshold applied to the positive class probability.
FND_DECISION_THRESHOLD=0.5
# Hard input limits enforced by the API schemas.
FND_MAX_TITLE_CHARS=512
FND_MAX_TEXT_CHARS=20000
FND_MAX_REQUEST_BYTES=262144
FND_MAX_BATCH_SIZE=64

# --- Rate limiting (in-process token bucket) --------------------------------
FND_RATE_LIMIT_ENABLED=true
FND_RATE_LIMIT_REQUESTS=60
FND_RATE_LIMIT_WINDOW_SECONDS=60

# --- Privacy / logging ------------------------------------------------------
# When false (recommended) request bodies are never written to logs.
FND_LOG_REQUEST_BODIES=false

# --- Streamlit frontend -----------------------------------------------------
FND_API_BASE_URL=http://127.0.0.1:8000
