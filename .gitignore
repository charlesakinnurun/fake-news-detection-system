# ---------------------------------------------------------------------------
# Data, artifacts and generated reports
# ---------------------------------------------------------------------------
# The raw dataset is NOT redistributed with this repository. See README section
# "Dataset" for provenance and licensing. Everything below is reproducible.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/interim/*
!data/interim/.gitkeep
artifacts/*
!artifacts/.gitkeep
reports/*
!reports/.gitkeep
logs/*
!logs/.gitkeep

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/
.venv/
venv/
env/
ENV/
.python-version

# ---------------------------------------------------------------------------
# Tooling caches
# ---------------------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
jupyter_execute/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Secrets / local configuration
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
